# Local development. make local generates a unique password if .env is absent.
POSTGRES_PASSWORD=
# Only needed for running backend commands outside Compose:
DATABASE_URL=postgresql+psycopg://reconcile:CHANGE_ME@127.0.0.1:5432/reconcile
APP_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=false
CODE_VERSION=development
